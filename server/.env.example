# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lastmile_db"

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────
PORT=4000
CLIENT_URL="http://localhost:5173"

# ── Email (Nodemailer) ────────────────────────────────────
# Use Mailtrap for local dev: https://mailtrap.io
# Use Gmail (with App Password) for production
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@lastmiledelivery.com"

# ── Assignment ────────────────────────────────────────────
# Radius (km) for fallback haversine agent search
AUTO_ASSIGN_RADIUS_KM=50
# Max concurrent orders per agent before they're marked unavailable
AGENT_CONCURRENT_ORDERS=1
